  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9caf9c"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#afc2ad"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "storage.type.string.python"
      ],
      "settings": {
        "foreground": "#d0d68d"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#c8d284"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#93cdbd"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "number"
      ],
      "settings": {
        "foreground": "#d6c77d"
      }
    },
    {
      "name": "Booleans",
      "scope": [
        "constant.language.boolean",
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#d6c77d"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#d6c77d"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#8fd69a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "punctuation.separator.annotation.result.python"
      ],
      "settings": {
        "foreground": "#b7d7b3"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#93cdbd"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "support.type",
        "support.class",
        "storage.type.cs",
        "storage.type.java",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#acd6c8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constructors",
      "scope": [
        "entity.name.function.constructor",
        "meta.function-call.constructor",
        "support.function.construct"
      ],
      "settings": {
        "foreground": "#acd6c8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#b8dea3"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#c5d8a7"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#c4d3c0"
      }
    },
    {
      "name": "Special variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super",
        "variable.other.readwrite.instance",
        "variable.other.readwrite.class"
      ],
      "settings": {
        "foreground": "#c4cf8d"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8fd69a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.css",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#c0d88f"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label",
        "entity.name.section",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#c4cf8d"
      }
    },
    {
      "name": "Variants",
      "scope": [
        "entity.name.type.variant",
        "entity.name.type.enum.variant",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#b8dea3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.block"
      ],
      "settings": {
        "foreground": "#c6d3c2"
      }
    },
    {
      "name": "Delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#98a899"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "constant.character.format.placeholder.other.python"
      ],
      "settings": {
        "foreground": "#a9b7a8"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#d9e6d6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold text",
      "scope": [
        "markup.bold",
        "markup.bold string"
      ],
      "settings": {
        "foreground": "#d9e6d6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic text",
      "scope": [
        "markup.italic",
        "markup.italic string"
      ],
      "settings": {
        "foreground": "#c4d3c0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": {
        "foreground": "#b1e0a5"
      }
    },
    {
      "name": "Link destinations",
      "scope": [
        "markup.underline.link.image",
        "meta.link.destination",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#9fcfc2"
      }
    },
    {
      "name": "Literal text",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.quote",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#d0d68d"
      }
    },
    {
      "name": "Embedded source",
      "scope": [
        "meta.embedded",
        "source.embedded",
        "storage.type.format.python"
      ],
      "settings": {
        "foreground": "#cddfca"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e09a96"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#c4d3c0",
    "type": {
      "foreground": "#acd6c8",
      "bold": true
    },
    "class": {
      "foreground": "#acd6c8",
      "bold": true
    },
    "enum": {
      "foreground": "#acd6c8",
      "bold": true
    },
    "interface": {
      "foreground": "#acd6c8",
      "bold": true
    },
    "struct": {
      "foreground": "#acd6c8",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#acd6c8",
      "bold": true
    },
    "parameter": "#c4d3c0",
    "selfParameter": "#c4cf8d",
    "clsParameter": "#c4cf8d",
    "variable": "#c4d3c0",
    "property": "#c5d8a7",
    "enumMember": "#d6c77d",
    "event": "#b8dea3",
    "function": "#b8dea3",
    "method": "#b8dea3",
    "macro": "#93cdbd",
    "label": "#c4cf8d",
    "comment": "#9caf9c",
    "string": "#d0d68d",
    "number": "#d6c77d",
    "regexp": "#c8d284",
    "operator": "#b7d7b3",
    "keyword": {
      "foreground": "#8fd69a",
      "bold": true
    },
    "decorator": "#b8dea3",
    "variable.readonly": "#d6c77d",
    "property.readonly": "#d6c77d",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
